{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "checked"],
  "properties": {
    "verdict": { "type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "topic", "file", "line_start", "line_end", "spec_item", "todo", "problem", "required_change"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocking", "nonblocking"] },
          "topic": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "line_start": { "type": ["integer", "null"] },
          "line_end": { "type": ["integer", "null"] },
          "spec_item": { "type": ["integer", "null"] },
          "todo": { "type": ["string", "null"] },
          "problem": { "type": "string" },
          "required_change": { "type": "string" }
        }
      }
    },
    "checked": { "type": "array", "items": { "type": "string" } }
  }
}
